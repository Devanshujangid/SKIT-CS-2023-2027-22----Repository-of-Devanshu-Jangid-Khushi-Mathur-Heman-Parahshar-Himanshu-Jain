    {
      "name": "Admin Broadcasts",
      "description": "Endpoints testing admin manual notification broadcasting, RBAC enforcement, and history.",
      "item": [
        {
          "name": "POST /api/v1/notifications/admin/broadcast - Admin Success",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Campus Midterm Examination Timetable\",\n  \"message\": \"Midterm assessments have been published. Please review your personalized study calendar.\",\n  \"type\": \"exam\",\n  \"target_role\": \"student\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/notifications/admin/broadcast",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "notifications", "admin", "broadcast"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 201 Created', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "pm.test('Broadcast returns recipient count', function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.success).to.be.true;",
                  "    pm.expect(json.recipient_count).to.be.above(0);",
                  "    pm.expect(json.title).to.eql('Campus Midterm Examination Timetable');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "POST /api/v1/notifications/admin/broadcast - 403 Forbidden Rejection",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Unauthorized Student Broadcast Attempt\",\n  \"message\": \"This should be rejected by require_admin middleware.\",\n  \"type\": \"system\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/notifications/admin/broadcast",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "notifications", "admin", "broadcast"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 403 Forbidden', function () {",
                  "    pm.response.to.have.status(403);",
                  "});",
                  "pm.test('Detail confirms lack of admin role', function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.detail).to.include('Access forbidden');",
                  "});"
                ]
              }
            }
          ]
        },
