    {
      "name": "Notifications",
      "description": "Endpoints testing student notifications, mark-as-read, delete, and engine triggers.",
      "item": [
        {
          "name": "GET /api/v1/notifications - List Student Alerts",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/notifications?limit=50&offset=0",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "notifications"],
              "query": [
                { "key": "limit", "value": "50" },
                { "key": "offset", "value": "0" }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Response matches NotificationListResponse schema', function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.success).to.be.true;",
                  "    pm.expect(json).to.have.property('unread_count');",
                  "    pm.expect(json).to.have.property('total_count');",
                  "    pm.expect(json.notifications).to.be.an('array');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /api/v1/notifications?unread_only=true",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/notifications?unread_only=true",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "notifications"],
              "query": [
                { "key": "unread_only", "value": "true" }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('All returned notifications are unread', function () {",
                  "    var json = pm.response.json();",
                  "    json.notifications.forEach(function (n) {",
                  "        pm.expect(n.is_read).to.be.false;",
                  "    });",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "POST /api/v1/notifications - Create Study Alert",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Upcoming Exam Reminder\",\n  \"message\": \"Unit 2 Midterm scheduled for Wednesday 10:00 AM.\",\n  \"type\": \"exam\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/notifications",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "notifications"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 201 Created', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "pm.test('Notification created with type exam', function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.success).to.be.true;",
                  "    pm.expect(json.notification.type).to.eql('exam');",
                  "    pm.expect(json.notification.is_read).to.be.false;",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "PATCH /api/v1/notifications/{id}/read - Mark Single as Read",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/notifications/{{sampleNotificationId}}/read",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "notifications", "{{sampleNotificationId}}", "read"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200 OK or 404', function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 404]);",
                  "});",
                  "if (pm.response.code === 200) {",
                  "    pm.test('Notification is_read is updated to true', function () {",
                  "        var json = pm.response.json();",
                  "        pm.expect(json.success).to.be.true;",
                  "        pm.expect(json.notification.is_read).to.be.true;",
                  "    });",
                  "}"
                ]
              }
            }
          ]
        },
