  "item": [
    {
      "name": "AI Chat",
      "description": "Endpoints testing real-time SSE streaming, JSON fallback, guardrails, and validation.",
      "item": [
        {
          "name": "POST /api/v1/chat - Real-Time SSE Stream",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"message\": \"Explain Peterson's algorithm for two-process mutual exclusion\",\n  \"stream\": true\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/chat",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "chat"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Response is text/event-stream', function () {",
                  "    pm.expect(pm.response.headers.get('Content-Type')).to.include('text/event-stream');",
                  "});",
                  "pm.test('Cache-Control is no-cache', function () {",
                  "    pm.expect(pm.response.headers.get('Cache-Control')).to.include('no-cache');",
                  "});",
                  "pm.test('Stream emits content delta chunks', function () {",
                  "    pm.expect(pm.response.text()).to.include('data:');",
                  "    pm.expect(pm.response.text()).to.include('[DONE]');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "POST /api/v1/chat - Standard JSON Payload",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"message\": \"What is process synchronization in Operating Systems?\",\n  \"stream\": false\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/chat",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "chat"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Response is application/json', function () {",
                  "    pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json');",
                  "});",
                  "pm.test('Response contains explanation and recommendations', function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.success).to.be.true;",
                  "    pm.expect(json).to.have.property('explanation');",
                  "    pm.expect(json).to.have.property('recommendations');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "POST /api/v1/chat - Academic Guardrail Refusal",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"message\": \"Who won the cricket match yesterday?\",\n  \"stream\": true\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/chat",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "chat"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Stream emits refusal payload', function () {",
                  "    pm.expect(pm.response.text()).to.include('refusal');",
                  "    pm.expect(pm.response.text()).to.include('is_refused');",
                  "    pm.expect(pm.response.text()).to.include('[DONE]');",
                  "});"
                ]
              }
            }
          ]
        },
