{
  "info": {
    "_postman_id": "a1b2c3d4-e5f6-7a8b-9c0d-1e2f3a4b5c6d",
    "name": "Smart Learning Planner - Leaderboard & Admin APIs",
    "description": "Comprehensive Postman test collection for Leaderboard, Goal Status, Admin Student Management, Global Subjects Catalog, Admin Resources, and Midnight Cron triggers.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8000", "type": "string" },
    { "key": "authToken", "value": "mock_student_clerk_token", "type": "string" },
    { "key": "adminToken", "value": "mock_admin_clerk_token", "type": "string" },
    { "key": "studentId", "value": "11111111-1111-1111-1111-111111111111", "type": "string" },
    { "key": "resourceId", "value": "55555555-5555-5555-5555-555555555555", "type": "string" },
    { "key": "subjectId", "value": "88888888-8888-8888-8888-888888888888", "type": "string" }
  ],
  "item": [
    {
      "name": "Leaderboard",
      "item": [
        {
          "name": "GET /api/v1/leaderboard",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{authToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/v1/leaderboard?limit=25&offset=0", "host": ["{{baseUrl}}"], "path": ["api", "v1", "leaderboard"], "query": [{ "key": "limit", "value": "25" }, { "key": "offset", "value": "0" }] }
          }
        },
        {
          "name": "PATCH /api/v1/analytics/goal-status",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"goal_status\": \"ahead\"\n}" },
            "url": { "raw": "{{baseUrl}}/api/v1/analytics/goal-status", "host": ["{{baseUrl}}"], "path": ["api", "v1", "analytics", "goal-status"] }
          }
        }
      ]
    },
    {
      "name": "Admin Resources",
      "item": [
        {
          "name": "POST /api/v1/admin/resources",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"title\": \"Operating Systems: Three Easy Pieces\",\n  \"url\": \"https://pages.cs.wisc.edu/~remzi/OSTEP/\",\n  \"category\": \"book\",\n  \"subject\": \"Operating Systems\"\n}" },
            "url": { "raw": "{{baseUrl}}/api/v1/admin/resources", "host": ["{{baseUrl}}"], "path": ["api", "v1", "admin", "resources"] }
          }
        },
        {
          "name": "PATCH /api/v1/admin/resources/{id}",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"rating\": 5.0,\n  \"difficulty\": \"advanced\"\n}" },
            "url": { "raw": "{{baseUrl}}/api/v1/admin/resources/{{resourceId}}", "host": ["{{baseUrl}}"], "path": ["api", "v1", "admin", "resources", "{{resourceId}}"] }
          }
        },
        {
          "name": "DELETE /api/v1/admin/resources/{id}",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/v1/admin/resources/{{resourceId}}", "host": ["{{baseUrl}}"], "path": ["api", "v1", "admin", "resources", "{{resourceId}}"] }
          }
        },
        {
          "name": "GET /api/v1/admin/resources",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/v1/admin/resources?limit=50", "host": ["{{baseUrl}}"], "path": ["api", "v1", "admin", "resources"], "query": [{ "key": "limit", "value": "50" }] }
          }
        }
      ]
    },
    {
      "name": "Admin Students",
      "item": [
        {
          "name": "GET /api/v1/admin/students",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/v1/admin/students?limit=50", "host": ["{{baseUrl}}"], "path": ["api", "v1", "admin", "students"], "query": [{ "key": "limit", "value": "50" }] }
          }
        },
        {
          "name": "PATCH /api/v1/admin/students/{id}/status",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"status\": \"suspended\",\n  \"reason\": \"Academic review\"\n}" },
            "url": { "raw": "{{baseUrl}}/api/v1/admin/students/{{studentId}}/status", "host": ["{{baseUrl}}"], "path": ["api", "v1", "admin", "students", "{{studentId}}", "status"] }
          }
        },
        {
          "name": "DELETE /api/v1/admin/students/{id}",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/v1/admin/students/{{studentId}}", "host": ["{{baseUrl}}"], "path": ["api", "v1", "admin", "students", "{{studentId}}"] }
          }
        }
      ]
    },
    {
      "name": "Admin Subjects",
      "item": [
        {
          "name": "POST /api/v1/admin/subjects",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"code\": \"5CS4-01\",\n  \"name\": \"Operating Systems\",\n  \"semester\": 5,\n  \"department\": \"Computer Science\",\n  \"credits\": 3.0\n}" },
            "url": { "raw": "{{baseUrl}}/api/v1/admin/subjects", "host": ["{{baseUrl}}"], "path": ["api", "v1", "admin", "subjects"] }
          }
        },
        {
          "name": "GET /api/v1/admin/subjects",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/v1/admin/subjects?semester=5", "host": ["{{baseUrl}}"], "path": ["api", "v1", "admin", "subjects"], "query": [{ "key": "semester", "value": "5" }] }
          }
        },
        {
          "name": "PATCH /api/v1/admin/subjects/{id}",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"credits\": 4.0\n}" },
            "url": { "raw": "{{baseUrl}}/api/v1/admin/subjects/{{subjectId}}", "host": ["{{baseUrl}}"], "path": ["api", "v1", "admin", "subjects", "{{subjectId}}"] }
          }
        },
        {
          "name": "DELETE /api/v1/admin/subjects/{id}",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/v1/admin/subjects/{{subjectId}}", "host": ["{{baseUrl}}"], "path": ["api", "v1", "admin", "subjects", "{{subjectId}}"] }
          }
        }
      ]
    },
    {
      "name": "Admin Notifications & Cron",
      "item": [
        {
          "name": "POST /api/v1/admin/notifications",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"title\": \"Campus Advisory\",\n  \"message\": \"Midterm examinations start next week.\",\n  \"type\": \"exam\",\n  \"target_role\": \"student\"\n}" },
            "url": { "raw": "{{baseUrl}}/api/v1/admin/notifications", "host": ["{{baseUrl}}"], "path": ["api", "v1", "admin", "notifications"] }
          }
        },
        {
          "name": "POST /api/v1/admin/leaderboard/refresh",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/v1/admin/leaderboard/refresh?dry_run=true", "host": ["{{baseUrl}}"], "path": ["api", "v1", "admin", "leaderboard", "refresh"], "query": [{ "key": "dry_run", "value": "true" }] }
          }
        }
      ]
    }
  ]
}

